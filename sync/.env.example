# Postgres (Neon) -- la misma que usa web/
DATABASE_URL=postgresql://user:password@host/vitacora?sslmode=require

# Garmin Connect (no oficial -- ver plan, riesgo #1 y #5)
GARMIN_EMAIL=tu-email@ejemplo.com
GARMIN_PASSWORD=tu-contraseña

# Google Health API -- generado por google_health_auth.get_credentials()
# la primera vez que corrés el sync localmente (abre el navegador).
GOOGLE_CLIENT_SECRETS_PATH=client_secrets.json
