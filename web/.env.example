# Postgres (Neon) -- la misma que usa sync/
DATABASE_URL=postgresql://user:password@host/vitacora?sslmode=require

# Auth de un solo usuario (ver plan Fase 0)
VITACORA_PASSWORD=elegí-una-contraseña
VITACORA_SESSION_SECRET=generar-con-openssl-rand-hex-32

# La API key de Anthropic NO va acá -- se carga en /settings y vive
